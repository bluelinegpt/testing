{
  "name": "@blueline/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:database": "vitest run src/authentication/authentication.database.test.ts",
    "test:communication:database": "vitest run src/communication/communication.customer-session.database.test.ts src/communication/communication.customer-rest.database.test.ts src/communication/communication.customer-websocket.database.test.ts src/communication/communication.cross-role.database.test.ts src/communication/communication.message-integrity.database.test.ts src/communication/communication.replay-outbox.database.test.ts src/communication/communication.office-actions.database.test.ts src/communication/communication.voice-messages.database.test.ts src/communication/communication.cleanup-verification.database.test.ts",
    "test:administration:database": "vitest run src/platform/administration.database.test.ts",
    "test:platform:database": "vitest run src/platform/platform-administration.database.test.ts",
    "test:platform-company:database": "vitest run src/platform/platform-company.database.test.ts",
    "test:platform-company-user:database": "vitest run src/platform/platform-company-user.database.test.ts",
    "test:integrity:database": "vitest run src/infrastructure/database/integrity.database.test.ts",
    "test:provisioning:database": "vitest run src/platform/company-defaults.database.test.ts src/platform/development-company-bootstrap.database.test.ts",
    "test:reconciliation:database": "vitest run src/operations/driver-cash-reconciliation.database.test.ts",
    "test:public-tracking:database": "vitest run src/operations/public-tracking.database.test.ts",
    "test:operator-mobile:database": "vitest run src/operations/operator-mobile-workflow.http.database.test.ts",
    "test:driver-mobile:database": "vitest run src/operations/driver-mobile-workflow.http.database.test.ts",
    "test:push:database": "vitest run src/push/push.database.test.ts",
    "test:push:http": "vitest run src/push/push-notifications.http.database.test.ts",
    "test:driver-offline:http": "vitest run src/operations/driver-offline-sync.http.database.test.ts",
    "test:concurrency:database": "vitest run src/operations/driver-cash-reconciliation.concurrency.test.ts src/operations/concurrency-isolation.test.ts",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx src/infrastructure/database/run-migrations.ts up",
    "db:migrate:down": "tsx src/infrastructure/database/run-migrations.ts down",
    "db:migrate:prod": "node dist/infrastructure/database/run-migrations.js up",
    "dev:import-areas": "tsx src/platform/run-uae-area-import.ts",
    "db:verify": "tsx src/infrastructure/database/verify-schema.ts",
    "db:reset:dev": "tsx src/platform/run-development-data-reset.ts",
    "reset:test-data": "tsx src/platform/reset-company-test-data.cli.ts",
    "accounting:template:export": "tsx src/accounting-template/export-accounting-template.cli.ts",
    "test:accounting-template": "vitest run src/accounting-template",
    "test:accounting-template:database": "vitest run src/accounting-template/accounting-template.database.test.ts",
    "test:reset-tool": "vitest run src/platform/reset-company-test-data.safety.test.ts src/platform/reset-company-test-data.guards.test.ts",
    "test:reset:database": "vitest run src/platform/reset-company-test-data.database.test.ts",
    "security:bootstrap-platform": "tsx src/platform/run-platform-administrator-bootstrap.ts",
    "security:bootstrap-platform:prod": "node dist/platform/run-platform-administrator-bootstrap.js",
    "security:reset-platform-admin-password": "tsx src/platform/run-platform-administrator-password-reset.ts",
    "security:reset-platform-admin-password:prod": "node dist/platform/run-platform-administrator-password-reset.js",
