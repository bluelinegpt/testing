{
  "name": "@blueline/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:database": "vitest run src/authentication/authentication.database.test.ts",
    "test:administration:database": "vitest run src/platform/administration.database.test.ts",
    "test:integrity:database": "vitest run src/infrastructure/database/integrity.database.test.ts",
    "test:provisioning:database": "vitest run src/platform/company-defaults.database.test.ts src/platform/development-company-bootstrap.database.test.ts",
    "test:reconciliation:database": "vitest run src/operations/driver-cash-reconciliation.database.test.ts",
    "test:concurrency:database": "vitest run src/operations/driver-cash-reconciliation.concurrency.test.ts src/operations/concurrency-isolation.test.ts",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx src/infrastructure/database/run-migrations.ts up",
    "db:migrate:down": "tsx src/infrastructure/database/run-migrations.ts down",
    "db:migrate:prod": "node dist/infrastructure/database/run-migrations.js up",
    "dev:import-areas": "tsx src/platform/run-uae-area-import.ts",
    "db:verify": "tsx src/infrastructure/database/verify-schema.ts",
    "security:bootstrap-platform": "tsx src/platform/run-platform-administrator-bootstrap.ts",
    "security:bootstrap-platform:prod": "node dist/platform/run-platform-administrator-bootstrap.js",
    "dev:bootstrap-company": "tsx src/platform/run-development-company-bootstrap.ts",
    "test:history:database": "vitest run src/operations/operations-history.regression.test.ts",
    "test:reconciliation:http": "vitest run src/operations/reconciliation-http.database.test.ts",
    "dev:seed-reconciliation-demo": "tsx src/platform/run-reconciliation-demo-seed.ts",
    "test:fixture:database": "vitest run src/platform/reconciliation-demo-seed.database.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "kysely": "^0.29.3",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "vitest": "^4.1.10"
  }
}
