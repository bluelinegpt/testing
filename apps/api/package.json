    "dev:seed-commerce": "tsx src/platform/run-commerce-development-seed.ts",
    "dev:seed-commerce-media": "tsx src/platform/run-commerce-media-seed.ts",
    "dev:bootstrap-company": "tsx src/platform/run-development-company-bootstrap.ts",
    "test:history:database": "vitest run src/operations/operations-history.regression.test.ts",
    "test:reconciliation:http": "vitest run src/operations/reconciliation-http.database.test.ts",
    "dev:seed-reconciliation-demo": "tsx src/platform/run-reconciliation-demo-seed.ts",
    "test:fixture:database": "vitest run src/platform/reconciliation-demo-seed.database.test.ts",
    "test:company-profile:database": "vitest run src/company-profile/company-profile.database.test.ts",
    "test:commerce:database": "vitest run src/storefront/trader-commerce.database.test.ts",
    "test:commerce-ownership:database": "vitest run src/storefront/trader-commerce-ownership.database.test.ts",
    "test:commerce-upload:database": "vitest run src/storefront/commerce-media-upload.database.test.ts",
    "test:marketplace:database": "vitest run src/marketplace/marketplace-taxonomy.database.test.ts",
    "test:commerce-media:database": "vitest run src/storefront/commerce-media-ownership.database.test.ts"
