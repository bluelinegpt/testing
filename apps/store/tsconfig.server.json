{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-server",
    "rootDir": ".",
    "tsBuildInfoFile": "dist-server/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "src/seo/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
