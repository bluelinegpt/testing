{
  "companyName": "Sample Delivery LLC",
  "contactPerson": "Sample Manager",
  "mobileNumber": "+971501112222",
  "email": "demo@example.com",
  "country": "United Arab Emirates",
  "emirate": "dubai",
  "approximateDriverCount": 25,
  "approximateMonthlyOrders": 2500,
