{
  "name": "bluelinegpt",
  "version": "0.1.0",
  "private": true,
  "description": "BluelineGPT delivery management platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:api": "pnpm --filter @blueline/api dev",
    "dev:web": "pnpm --filter @blueline/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:dependencies": "pnpm audit --prod --audit-level high",
    "migrations:validate": "node scripts/validate-migrations.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "reset:test-data": "pnpm --filter @blueline/api run reset:test-data",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "ci:validate": "pnpm security:secrets && pnpm migrations:validate && pnpm validate && pnpm security:dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
