NODE_ENV=development
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5174
DATABASE_URL=postgresql://blueline:change-me@localhost:5432/bluelinegpt
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:5174
LOG_LEVEL=info
REQUEST_BODY_LIMIT_MB=10
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
AUTH_LOCKOUT_MINUTES=15
AUTH_SESSION_TTL_MINUTES=720
FILE_STORAGE_PROVIDER=local
# Absolute directory for privately-stored file bytes (e.g. Company logos). Must
# live outside any web root; served only via authenticated endpoints. Defaults
# to <api-cwd>/.file-storage in development when unset. Required in production.
FILE_STORAGE_LOCAL_ROOT=
EMAIL_PROVIDER=unconfigured
# Firebase Admin SDK service-account credential, as a single-line JSON string
# (never a file path, never committed). Push notifications run in DEV without
# it — FirebasePushProvider reports "not configured" safely instead of
# crashing the API. Required for live push delivery.
FIREBASE_SERVICE_ACCOUNT_JSON=
VITE_API_BASE_URL=http://localhost:3000/api/v1
WEB_PORT=8080
WEB_TENANT_HOST_SUFFIX=tawseelhub.com
# Optional, explicit old-host redirects during a controlled cutover. Remove the
# Dana entry before assigning dana.tawseelhub.com to the future public website.
WEB_LEGACY_TENANT_REDIRECTS=dana.tawseelhub.com=https://danaapp.tawseelhub.com
POSTGRES_DB=bluelinegpt
POSTGRES_USER=blueline
POSTGRES_PASSWORD=change-me-local-only

# Multi-tenant Company resolution.
# Production: the Company is taken from the tenant label of the request host,
# e.g. acmeapp.tawseelhub.com resolves to the Company subdomain "acme".
BLUELINE_TENANT_HOST_SUFFIX=tawseelhub.com
# Development only: fallback Company subdomain used when the host carries no
# tenant label (localhost, an IP). Rejected outright if NODE_ENV=production.
BLUELINE_DEV_COMPANY_SUBDOMAIN=dev

# Tawseelhub commerce integration providers.
# Mock Commerce is development-only and supports local acceptance testing.
COMMERCE_MOCK_PROVIDER_ENABLED=true

# Salla connector. Keep disabled until a real Salla app/test store is ready.
SALLA_INTEGRATION_ENABLED=false
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=http://localhost:3000/api/v1/integrations/commerce/salla/oauth/callback
SALLA_WEBHOOK_SECRET=

# Shopify connector. Keep disabled until a real Shopify app/development store is ready.
SHOPIFY_INTEGRATION_ENABLED=false
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:3000/api/v1/integrations/commerce/shopify/oauth/callback
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_WEBHOOK_CALLBACK_BASE_URL=http://localhost:3000
# Optional override. Shopify normally signs webhooks with the app client secret.
SHOPIFY_WEBHOOK_SECRET=
